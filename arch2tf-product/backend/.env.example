# Copy this file to .env (same directory) and adjust before deploying.
# `docker compose up` (see ../../docker-compose.yml) loads .env into the
# `api` container automatically via env_file — nothing here needs exporting
# by hand. Never commit a real .env with actual secrets in it.

# ── App ──────────────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["null"]
# Same-origin via nginx (see docker-compose.yml) means CORS normally never
# comes into play — this only matters if something ever talks to the `api`
# container directly on :8000, bypassing nginx.

# ── AWS sandbox (terraform validate/plan during the normal pipeline, and
# the real "Apply to Sandbox" apply/destroy) ────────────────────────────
# Leave this whole section commented out if the EC2 instance has an IAM
# instance role attached (recommended — see the deployment runbook): both
# boto3 and terraform automatically pick up credentials from the instance
# metadata service with no keys anywhere in this file. Only uncomment and
# fill these in if you're deploying somewhere WITHOUT an instance role
# available (a non-EC2 VM, local testing, etc.).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
SANDBOX_ENABLED=true

# ── Apply to Sandbox auto-destroy safety net ────────────────────────────
APPLY_AUTO_DESTROY_HOURS=2.0

# ── Remote state backend (optional — leave both sections blank/unset to
# keep every job's terraform.tfstate local to the api container's
# persistent volume; fine for solo use, not for multiple reviewers hitting
# apply/plan on the same job at once) ───────────────────────────────────
# Option A — S3 + DynamoDB:
# TF_BACKEND_TYPE=s3
# TF_STATE_BUCKET=your-terraform-state-bucket
# TF_STATE_LOCK_TABLE=terraform-locks
# TF_STATE_REGION=us-east-1
#
# Option B — Terraform Cloud / HCP Terraform (added 2026-07-29):
# TF_BACKEND_TYPE=cloud
# TF_CLOUD_ORGANIZATION=your-tfc-org
# TF_CLOUD_HOSTNAME=app.terraform.io
# Auth for this option comes from `terraform login` run once inside the
# api container (or TF_TOKEN_<hostname> set here) — never a value this
# tool stores or generates itself.

# ── Vision-LLM image detection (optional — only needed if you want the
# Claude-based diagram parser instead of the classical CV cascade) ──────
# ANTHROPIC_API_KEY=
# ARCH2TERRAFORM_USE_VISION_LLM=true
# ARCH2TERRAFORM_VISION_LLM_MODEL=claude-haiku-4-5-20251001

# ── Clarification behavior ──────────────────────────────────────────────
MAX_CLARIFICATION_ROUNDS=2
CONFIDENCE_THRESHOLD=0.6
