<mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- VPC container -->
    <mxCell id="vpc1" value="Main VPC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;group=1;container=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="40" width="600" height="400" as="geometry" />
    </mxCell>

    <!-- Subnet container, nested inside VPC -->
    <mxCell id="subnet1" value="Public Subnet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;group=1;container=1;" vertex="1" parent="vpc1">
      <mxGeometry x="20" y="60" width="300" height="300" as="geometry" />
    </mxCell>

    <!-- EC2 instance inside subnet -->
    <mxCell id="ec2_1" value="Web Server" style="sketch=0;outlineConnect=0;fontColor=#232F3E;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="subnet1">
      <mxGeometry x="40" y="40" width="60" height="60" as="geometry" />
    </mxCell>

    <!-- Internet Gateway inside VPC, outside subnet -->
    <mxCell id="igw_1" value="Internet Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.internet_gateway;" vertex="1" parent="vpc1">
      <mxGeometry x="380" y="60" width="60" height="60" as="geometry" />
    </mxCell>

    <!-- S3 bucket, outside the VPC entirely -->
    <mxCell id="s3_1" value="Static Assets Bucket" style="sketch=0;outlineConnect=0;fontColor=#232F3E;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
      <mxGeometry x="720" y="120" width="60" height="60" as="geometry" />
    </mxCell>

    <!-- Edge: EC2 -> S3 -->
    <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ec2_1" target="s3_1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Edge: EC2 -> Internet Gateway -->
    <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ec2_1" target="igw_1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
  </root>
</mxGraphModel>
